# Copy to .env.local and fill in the values from Firebase Console → Project settings → General → Your apps → Web app.
# These Firebase web-app values identify the client project; they are not Admin SDK secrets.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Optional only when your FastAPI backend is not served via the Vite /api proxy.
# VITE_API_URL=http://localhost:8000
